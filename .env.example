# Paddle Billing — live production configuration only.
# Vite variables are public at build time. Keep only the live Paddle client-side
# token here; never expose server API keys or webhook signing secrets.
VITE_PADDLE_ENVIRONMENT=production
VITE_PADDLE_CLIENT_TOKEN=

# Configure the following values exclusively as Supabase Edge Function secrets.
# Do not add them to Vite, Vercel-public, browser, or committed local env files.
# PADDLE_ENVIRONMENT=production
# PADDLE_API_KEY=              # Live Paddle API key; used only by server routes.
# PADDLE_WEBHOOK_SECRET=       # Notification destination endpoint signing secret.
# APP_URL=https://mybizctrl.site
#
# Required functions:
#   paddle-subscription-webhook  (public webhook; JWT verification disabled)
#   paddle-customer-portal       (authenticated; JWT verification enabled)
#   paddle-subscription-checkout (authenticated; JWT verification enabled)
#
# The live notification destination must post to:
# https://mqubwgbppncldyiicbtu.supabase.co/functions/v1/paddle-subscription-webhook
# Subscribe it to customer.created, customer.updated, subscription.created,
# subscription.updated, subscription.canceled, and transaction.completed.

# Configure live Paddle price IDs only in public.subscription_plans after the
# matching live catalog prices have been created:
# starter_20     -> live monthly $10 USD price ID
# growth_40      -> live monthly $20 USD price ID
# enterprise_100 -> live monthly $50 USD price ID
