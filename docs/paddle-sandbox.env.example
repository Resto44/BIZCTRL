# Paddle Billing — Sandbox only. Do not put real values in this tracked file.
# Vite variables are public at build time. Only the official Paddle client-side
# token belongs here; it must begin with test_.
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_CLIENT_TOKEN=

# Configure the following only as server-side Supabase Edge Function secrets.
# Do not add them to a Vite, Vercel-public, or frontend environment file.
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# APP_URL=https://mybizctrl.site

# Configure the three real Sandbox price IDs only in public.subscription_plans:
# starter_20    -> real $10 USD/month Sandbox Paddle price ID
# growth_40     -> real $20 USD/month Sandbox Paddle price ID
# enterprise_100 -> real $50 USD/month Sandbox Paddle price ID
