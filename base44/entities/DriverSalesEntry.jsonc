{
  "name": "DriverSalesEntry",
  "type": "object",
  "properties": {
    "closing_id": {
      "type": "string",
      "description": "Immutable parent DailySales closing identifier"
    },
    "sales_source_id": {
      "type": "string",
      "description": "Canonical configured Sales Source identifier"
    },
    "subcategory": {
      "type": "string",
      "description": "Sales Source sub-category, such as Drivers"
    },
    "driver_id": {
      "type": "string",
      "description": "Canonical Driver Master identifier"
    },
    "driver_name": {
      "type": "string",
      "description": "Immutable Driver Master display-name snapshot"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "branch_id": {
      "type": "string",
      "description": "Canonical branch identifier"
    },
    "branch": {
      "type": "string",
      "description": "Branch key snapshot"
    },
    "shift": {
      "type": "string"
    },
    "cash_amount": {
      "type": "number",
      "minimum": 0,
      "description": "Physical cash collected by the driver for this closing"
    },
    "network_amount": {
      "type": "number",
      "minimum": 0,
      "description": "Network or card payment collected by the driver for this closing"
    },
    "total_amount": {
      "type": "number",
      "minimum": 0,
      "description": "Canonical total equal to cash_amount plus network_amount"
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "description": "Legacy compatibility mirror of total_amount"
    },
    "payment_method": {
      "type": "string",
      "description": "Legacy compatibility value; split entries use split"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "finalized", "cancelled"],
      "default": "draft"
    },
    "finalized_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "closing_id",
    "sales_source_id",
    "driver_id",
    "date",
    "branch_id",
    "cash_amount",
    "network_amount",
    "total_amount"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}
