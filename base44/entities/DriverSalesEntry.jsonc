{
  "name": "DriverSalesEntry",
  "type": "object",
  "properties": {
    "closing_id": {
      "type": "string",
      "description": "Immutable parent DailySales closing identifier"
    },
    "sales_source_id": {
      "type": "string",
      "description": "Canonical configured Sales Source identifier"
    },
    "subcategory": {
      "type": "string",
      "description": "Sales Source sub-category, such as Drivers"
    },
    "driver_id": {
      "type": "string",
      "description": "Canonical Driver Master identifier"
    },
    "driver_name": {
      "type": "string",
      "description": "Immutable Driver Master display-name snapshot"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "branch_id": {
      "type": "string",
      "description": "Canonical branch identifier"
    },
    "branch": {
      "type": "string",
      "description": "Branch key snapshot"
    },
    "shift": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "payment_method": {
      "type": "string",
      "description": "Cash, card/network, customer credit, or other canonical payment method"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "finalized", "cancelled"],
      "default": "draft"
    },
    "finalized_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "closing_id",
    "sales_source_id",
    "driver_id",
    "date",
    "branch_id",
    "amount",
    "payment_method"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}
